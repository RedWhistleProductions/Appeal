// Run: Appeal.exe "Utilities/Game_Editor/Database_Editor/Main"
Add_Dynamic_Module Graphics Appeal_SDL2_Legacy_OpenGL_Graphics
Add_Dynamic_Module Input Appeal_SDL2_Input
Add_Dynamic_Module Storage Appeal_SQLite_Storage
Add_Dynamic_Module Files Appeal_Standard_Files
Run Utilities/Game_Editor/Database_Editor/Editor
Graphics Add_Full_Screen_Window Main 0
Graphics Set_Window_Title Main "Database Editor"
Graphics Set_FPS 60
Graphics Set_GUI_Docking True
Graphics Set_GUI_Editor_Mode True
Graphics Set_GUI_Visible True
Input Set_Focus_Mouse_Button None
Input Set_Focus GUI
Set_Var DE_Running 1
Define_Function DE_Exit
    Set_Var DE_Running 0
End_Function
Define_Function DE_Reset_Layout
    Graphics GUI_Reset_Editor_Layout
End_Function
Loop While Var DE_Running == 1
{
    Input Update Default
    Graphics GUI_Begin_Frame
    Graphics GUI_Begin_Window Components
    Graphics GUI_Text DE_Component "Database Editor"
    Graphics GUI_Button DE_Reset_Button "Reset layout" DE_Reset_Layout
    Graphics GUI_Button DE_Exit_Button "Exit editor" DE_Exit
    Graphics GUI_End_Window
    Graphics GUI_Begin_Window "Editing View"
    Call DE_View
    Graphics GUI_End_Window
    Call DE_GUI
    Graphics Render
    Graphics Update
    Graphics Window_Open Main
    Set_Var_Global DE_Window_Open Graphics.Window.Main.Open
    If Var DE_Window_Open == 0 { Set_Var DE_Running 0 }
}
Storage Close Database_Editor_Workspace
Graphics Close_All
Done
