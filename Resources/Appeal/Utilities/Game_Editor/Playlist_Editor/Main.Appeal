// Run: Appeal.exe Utilities/Game_Editor/Playlist_Editor/Main
Add_Dynamic_Module Graphics Appeal_SDL2_Legacy_OpenGL_Graphics
Add_Dynamic_Module Input Appeal_SDL2_Input
Add_Dynamic_Module Storage Appeal_SQLite_Storage
Storage Use Tile_Editor
Run Utilities/Game_Editor/Playlist_Editor/Editor
Graphics Add_Window Main "Playlist Editor" 1280 800
Graphics Set_GUI_Docking True
Graphics Set_GUI_Editor_Mode True
Graphics Set_GUI_Visible True
Graphics Set_FPS 60
Input Set_Focus_Mouse_Button None
Input Set_Focus GUI
Set_Var PE_Open 1
Set_Var PE_Visible 1
Set_Var PE_Next_Level My_Level
Define_Function PE_Open_Level
    Graphics GUI_Text_Value PE_Level_Input
    Set_Var_Global PE_Next_Level Graphics.GUI.PE_Level_Input.Value
    Call PE_Show
End_Function
Loop While Var PE_Open == 1
{
    Input Update Default
    Graphics GUI_Begin_Frame
    Graphics GUI_Begin_Window "Level selection"
    Graphics GUI_Input_Text PE_Level_Input "Level name" Var PE_Next_Level None
    Graphics GUI_Button PE_Open_Button "Open level playlist" PE_Open_Level
    Graphics GUI_Button PE_Show_Button "Show Playlist Editor" PE_Show
    Graphics GUI_End_Window
    If Var PE_Visible == 1
    {
        Call PE_GUI
    }
    Graphics Render
    Graphics Update
    Graphics Window_Open Main
    Set_Var_Global PE_Open Graphics.Window.Main.Open
}
Call PE_Stop
Graphics Close_All
Storage Close Tile_Editor
Done
