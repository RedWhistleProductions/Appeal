// Idempotent sprite catalog; existing user edits are preserved.
Storage Open Tile_Editor
Storage Use Tile_Editor
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Editor_Level_Prototypes (Level_Name TEXT NOT NULL, Sprite TEXT NOT NULL, PRIMARY KEY(Level_Name, Sprite));"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Prototypes (Name TEXT PRIMARY KEY, Present TEXT);"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Context (Name TEXT PRIMARY KEY, Value TEXT);"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Editor_Level_Layers (Level_Name TEXT NOT NULL, Number TEXT NOT NULL, Section TEXT NOT NULL, PRIMARY KEY(Level_Name, Number));"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Layers (Number TEXT PRIMARY KEY, Section TEXT NOT NULL);"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Layer_Copy (Number TEXT, Section TEXT);"
Storage Execute_SQL "CREATE TEMP VIEW IF NOT EXISTS Editor_Layer_Info AS SELECT 'All' AS Name, count(*) AS Count, group_concat('Layer ' || Number,'|') AS Items, coalesce(max(CAST(Section AS INTEGER)),0)+1 AS Next_Section FROM (SELECT * FROM Editor_Layers ORDER BY CAST(Number AS INTEGER));"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Editor_Level_Folders (Level_Name TEXT, Section TEXT, Folder TEXT, Enabled TEXT, PRIMARY KEY(Level_Name,Section,Folder));"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Editor_Level_Palettes (Level_Name TEXT, Section TEXT, Opaque TEXT, Transparent TEXT, PRIMARY KEY(Level_Name,Section));"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Sprite_Info (Name TEXT PRIMARY KEY, Folder TEXT, Opaque INTEGER);"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Layer_Folders (Key TEXT PRIMARY KEY, Section TEXT, Folder TEXT, Enabled TEXT DEFAULT '1');"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Layer_Palettes (Section TEXT PRIMARY KEY, Opaque TEXT DEFAULT '1', Transparent TEXT DEFAULT '1');"
Storage Execute_SQL "CREATE TEMP VIEW IF NOT EXISTS Editor_Folder_List AS SELECT CAST(row_number() OVER (ORDER BY Folder)-1 AS TEXT) AS Number, Folder FROM (SELECT DISTINCT Folder FROM Editor_Sprite_Info);"
Storage Execute_SQL "CREATE TEMP VIEW IF NOT EXISTS Editor_Folder_Count AS SELECT 'All' AS Name, count(*) AS Count FROM Editor_Folder_List;"
Storage Execute_SQL "CREATE TEMP VIEW IF NOT EXISTS Editor_Filter_Folders AS SELECT d.Number, d.Folder, f.Key, f.Enabled FROM Editor_Folder_List d JOIN Editor_Layer_Folders f ON f.Folder=d.Folder WHERE f.Section=(SELECT Value FROM Editor_Context WHERE Name='Filter_Section');"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Tile_Files (File TEXT PRIMARY KEY, Folder TEXT, Kind TEXT, Data TEXT, Present INTEGER DEFAULT 1);"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Tile_Attributes (Name TEXT PRIMARY KEY, Folder TEXT, Source_Sheet TEXT, Opaque INTEGER, Category TEXT DEFAULT 'Tile', Tags TEXT DEFAULT '', Animated INTEGER DEFAULT 0, Animation_Group TEXT DEFAULT '');"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Import_Scan (Name TEXT PRIMARY KEY, Data TEXT);"
Storage Execute_SQL "CREATE TEMP TABLE IF NOT EXISTS Editor_Layer_Search (Section TEXT PRIMARY KEY, Search TEXT DEFAULT '');"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Editor_Level_Search (Level_Name TEXT, Section TEXT, Search TEXT, PRIMARY KEY(Level_Name,Section));"
Storage Begin
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Sprite_Extras (Name TEXT PRIMARY KEY, Second_Frame INTEGER NOT NULL);"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Sprites (Name TEXT PRIMARY KEY CHECK(length(Name)>0 AND instr(Name,'|')=0), File TEXT NOT NULL, Frame_Width INTEGER NOT NULL CHECK(Frame_Width>0), Frame_Height INTEGER NOT NULL CHECK(Frame_Height>0), Frame INTEGER NOT NULL CHECK(Frame>=0));"
Storage Execute_SQL "CREATE VIEW IF NOT EXISTS Editor_Sprite_List AS SELECT CAST(row_number() OVER (ORDER BY Name)-1 AS TEXT) AS Number, * FROM Sprites;"
Storage Execute_SQL "CREATE VIEW IF NOT EXISTS Editor_Catalog AS SELECT 'All' AS Name, group_concat(Name,'|') AS Items, count(*) AS Count FROM (SELECT Name FROM Sprites ORDER BY Name);"
