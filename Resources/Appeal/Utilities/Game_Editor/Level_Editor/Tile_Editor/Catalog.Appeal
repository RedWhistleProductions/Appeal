Storage Execute_SQL "CREATE INDEX IF NOT EXISTS Sprites_File ON Sprites(File);"
Storage Commit
Storage Execute_SQL "CREATE TEMP VIEW IF NOT EXISTS Editor_Brush_List AS SELECT CAST(row_number() OVER (ORDER BY s.Name)-1 AS TEXT) AS Number, s.* FROM Sprites s JOIN Editor_Sprite_Info i ON i.Name=s.Name JOIN Editor_Layer_Folders f ON f.Folder=i.Folder AND f.Section=(SELECT Value FROM Editor_Context WHERE Name='Active_Section') AND f.Enabled='1' JOIN Editor_Layer_Palettes p ON p.Section=f.Section LEFT JOIN Tile_Attributes a ON a.Name=s.Name LEFT JOIN Editor_Layer_Search q ON q.Section=f.Section WHERE ((i.Opaque=1 AND p.Opaque='1') OR (i.Opaque=0 AND p.Transparent='1')) AND instr(lower(s.Name || ' ' || s.File || ' ' || coalesce(a.Category,'') || ' ' || coalesce(a.Tags,'')), lower(coalesce(q.Search,'')))>0;"
Storage Execute_SQL "CREATE TEMP VIEW IF NOT EXISTS Editor_Brush_Catalog AS SELECT 'All' AS Name, count(*) AS Count, group_concat(Name,'|') AS Items FROM (SELECT Name FROM Editor_Brush_List ORDER BY Name);"
Return
