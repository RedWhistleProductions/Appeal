// Run: Appeal.exe "Utilities/Game_Editor/Appeal_IDE/Main"
Add_Dynamic_Module Graphics Appeal_SDL2_Legacy_OpenGL_Graphics
Add_Dynamic_Module Input Appeal_SDL2_Input
Add_Dynamic_Module Files Appeal_Standard_Files
Run Utilities/Game_Editor/Appeal_IDE/Editor
Graphics Add_Full_Screen_Window Main 0
Graphics Set_Window_Title Main "Appeal IDE"
Graphics Set_FPS 60
Graphics Set_GUI_Docking True
Graphics Set_GUI_Editor_Mode True
Graphics Set_GUI_Visible True
Input Set_Focus_Mouse_Button None
Input Set_Focus GUI
Set_Var IDE_Running 1
Define_Function IDE_Exit
    Set_Var IDE_Exit_Function IDE_Stop_Application
    Call IDE_Request_Exit
End_Function
Define_Function IDE_Stop_Application
    Set_Var IDE_Running 0
End_Function
Define_Function IDE_Reset_Layout
    Graphics GUI_Reset_Editor_Layout
End_Function
Loop While Var IDE_Running == 1
{
    Input Update Default
    Graphics GUI_Begin_Frame
    Graphics GUI_Begin_Window Components
    Graphics GUI_Text IDE_Component "Appeal IDE"
    Graphics GUI_Button IDE_Reset_Button "Reset layout" IDE_Reset_Layout
    Graphics GUI_Button IDE_Exit_Button "Exit editor" IDE_Exit
    Graphics GUI_End_Window
    Graphics GUI_Begin_Window "Editing View"
    Call IDE_View
    Graphics GUI_End_Window
    Call IDE_GUI
    Graphics Render
    Graphics Update
    Graphics Window_Open Main
    Set_Var_Global IDE_Window_Open Graphics.Window.Main.Open
    If Var IDE_Window_Open == 0 { Set_Var IDE_Running 0 }
}
Graphics Close_All
Done
