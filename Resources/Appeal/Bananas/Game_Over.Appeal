Graphics Draw_Rect Game_Over_Background 0.0 0.0 960.0 540.0 24 10 12 255
Graphics GUI_Begin Game_Over_Menu
Graphics GUI_Text Game_Over_Title "Game Over"
Graphics GUI_Button Continue_Button Continue None
Graphics GUI_Button Save_Button Save None
Graphics GUI_Button Quit_Game_Over_Button Quit None
Graphics GUI_End

Graphics GUI_Button_Clicked Continue_Button
Set_Var_Global Continue_Clicked GUI.Continue_Button.Clicked
If Var Continue_Clicked == 1
{
	Set_Var Game_State Bananas/Playing
}

Graphics GUI_Button_Clicked Save_Button
Set_Var_Global Save_Clicked GUI.Save_Button.Clicked
If Var Save_Clicked == 1
{
	Set_Var Game_State Bananas/Save_Menu
}

Graphics GUI_Button_Clicked Quit_Game_Over_Button
Set_Var_Global Quit_Clicked GUI.Quit_Game_Over_Button.Clicked
If Var Quit_Clicked == 1
{
	Graphics Close_All
}

Return
