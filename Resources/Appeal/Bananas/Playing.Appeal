// Check Input and AI.
AI Think Guard
AI Decide Guard

// Apply Physics and Mechanics.
Physics Update Player
Mechanics Update Player

// Check Scenarios.
// Scenario Update will go here after the Scenario module exists.

// Update World data.
World Update Main

// Render World.
Graphics Draw_Rect Game_Background 0.0 0.0 960.0 540.0 20 24 32 255
World Draw Main
Graphics Draw_Text MainFont "Game Running" 384.0 24.0
Graphics Draw_Text MainFont "Escape closes the window." 314.0 492.0
Graphics GUI_Begin Developer_Overlay
Graphics GUI_Text Developer_Title "Developer Overlay"
Graphics GUI_Text Developer_Hint "Tab toggles ImGui. In-game menus will use custom GUI later."
Graphics GUI_Button Item_Menu_Button Items None
Graphics GUI_Button Save_Menu_Button Save None
Graphics GUI_End

Graphics GUI_Button_Clicked Item_Menu_Button
Set_Var_Global Item_Menu_Clicked GUI.Item_Menu_Button.Clicked
If Var Item_Menu_Clicked == 1
{
	Set_Var Game_State Bananas/Item_Menu
}

Graphics GUI_Button_Clicked Save_Menu_Button
Set_Var_Global Save_Menu_Clicked GUI.Save_Menu_Button.Clicked
If Var Save_Menu_Clicked == 1
{
	Set_Var Game_State Bananas/Save_Menu
}

Return
