Graphics GUI_Tab_Item_Begin Audio##Editor_Audio
Graphics GUI_Text Audio_Title "Audio"

Set_Var Music_Playlist_File_Path ""
Set_Var Music_Playlist_Text ""
If Var Active_Game != ""
{
	If Var Active_Level != ""
	{
		Files Join Appeal/Games Var Active_Game
		Set_Var_Global Music_Game_Path Files.Last_Path
		Files Join Var Music_Game_Path Levels
		Set_Var_Global Music_Levels_Path Files.Last_Path
		Files Join Var Music_Levels_Path Var Active_Level
		Set_Var_Global Music_Level_Path Files.Last_Path
		Files Add_Extension Var Active_Level Playlist
		Set_Var_Global Music_Playlist_File_Name Files.Last_Path
		Files Join Var Music_Level_Path Var Music_Playlist_File_Name
		Set_Var_Global Music_Playlist_File_Path Files.Last_Path
		Files Read_All Var Music_Playlist_File_Path
		Set_Var_Global Music_Playlist_Text Files.Last_Read
	}
}

Graphics GUI_Text Music_Playlist_Label Var Music_Playlist_File_Path
Graphics GUI_Separator
Graphics GUI_Button Music_Add_Song_Button Add None
Graphics GUI_Same_Line
Graphics GUI_Button Music_Play_Button Play None
Graphics GUI_Same_Line
Graphics GUI_Button Music_Stop_Button Stop None

Graphics GUI_Group_Begin Music_File_Group
Graphics GUI_File_Picker Music_File_Picker Music Resources Audio/Music None
Set_Var_Global Music_Selected_Path Graphics.GUI.Music_File_Picker.Selected_Path
Set_Var_Global Music_Selected_Is_Directory Graphics.GUI.Music_File_Picker.Selected_Is_Directory
Set_Var_Global Music_Selected_Relative Graphics.GUI.Music_File_Picker.Selected_Relative
Graphics GUI_Text Music_Selected_Label Var Music_Selected_Relative
Graphics GUI_Group_End

Graphics GUI_Same_Line
Graphics GUI_Group_Begin Music_Playlist_Group
Graphics GUI_Text Music_Playlist_Title "Current Playlist"
Graphics GUI_Input_Text_Multiline Music_Playlist_Display Playlist Var Music_Playlist_Text 460 420 None
Graphics GUI_Group_End

Graphics GUI_Tab_Item_End

