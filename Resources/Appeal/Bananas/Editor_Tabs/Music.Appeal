Graphics GUI_Tab_Item_Begin Music
Graphics GUI_Text Music_Title "Music"
Graphics GUI_Text Music_Playlist_Label Var Music_Playlist_File_Path
Graphics GUI_Separator
Graphics GUI_Button Music_Add_Song_Button Add None
Graphics GUI_Same_Line
Graphics GUI_Button Music_Play_Button Play None
Graphics GUI_Same_Line
Graphics GUI_Button Music_Stop_Button Stop None
Graphics GUI_File_Picker Music_File_Picker Music Resources Audio/Music None
Set_Var_Global Music_Selected_Path Graphics.GUI.Music_File_Picker.Selected_Path
Set_Var_Global Music_Selected_Is_Directory Graphics.GUI.Music_File_Picker.Selected_Is_Directory
Set_Var_Global Music_Selected_Relative Graphics.GUI.Music_File_Picker.Selected_Relative
Graphics GUI_Text Music_Selected_Label Var Music_Selected_Relative
Graphics GUI_Tab_Item_End

Graphics GUI_Button_Clicked Music_Add_Song_Button
Set_Var_Global Music_Add_Song_Clicked GUI.Music_Add_Song_Button.Clicked
If Var Music_Add_Song_Clicked == True
{
	If Var Music_Selected_Is_Directory == False
	{
		Files Append_Line Var Music_Playlist_File_Path Var Music_Selected_Relative
	}
}

Graphics GUI_Button_Clicked Music_Play_Button
Set_Var_Global Music_Play_Clicked GUI.Music_Play_Button.Clicked
If Var Music_Play_Clicked == True
{
	If Var Music_Selected_Is_Directory == False
	{
		Audio Stop
		Audio Load_Song Preview Var Music_Selected_Relative
		Audio Play_Song Preview
	}
}

Graphics GUI_Button_Clicked Music_Stop_Button
Set_Var_Global Music_Stop_Clicked GUI.Music_Stop_Button.Clicked
If Var Music_Stop_Clicked == True
{
	Audio Stop
}

Return
