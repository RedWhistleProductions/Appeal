// One render/event loop; Mechanics owns movement and shared animation state.
// Standalone: Appeal.exe Examples/Animation_Music_Player
Run Setup/Config
Run Examples/Music_Player_Controls
Run Examples/Graphics/Setup_Character_Mechanics
Run Examples/Graphics/Character_Animation_Controls
Set_Var Music_Player_Overlay 1

Graphics Add_Window Main "Adam and Eve - GAME focus (F1 / Back: GUI)" 800 600
Graphics Set_FPS 60
Graphics Set_GUI_Docking False
Graphics Set_GUI_Visible True
Run Examples/Graphics/Setup_Characters
Run Examples/Graphics/Setup_Character_Input
Call Adam_Draw_Mechanics
Call Eve_Draw_Mechanics

Audio Load_Play_List "Play_All.txt"
Audio Auto_Play_Next 1
Audio Set_Volume_Percent 100
Audio Play

Graphics Window_Open Main
Set_Var_Global Music_Window_Open Graphics.Window.Main.Open
Loop While Var Music_Window_Open == 1
{
    Input Update Default
    Call Character_Check_Focus
    Call Music_Player_GUI
    Call Adam_Read_Input
    Call Eve_Read_Input
    Call Character_Mechanics_Update
    Call Adam_Draw_Mechanics
    Call Eve_Draw_Mechanics
    Graphics Render
    Graphics Update
    Graphics Window_Open Main
    Set_Var_Global Music_Window_Open Graphics.Window.Main.Open
}

Mechanics Release Adam
Mechanics Release Eve
Audio Stop
Input Close_Controller -1
Graphics Close_All
