// Run from the Appeal folder with Echo_Server.Appeal running first.
Network Debug On
Network Configure Echo 127.0.0.1 34567
Network Connect Echo

Print "Type a message and press Enter to send it. Type Done to disconnect."
Set_Var Reading 1
Loop While Var Reading == 1
{
    Print "Message:"
    // Read a complete terminal line; Reading becomes 0 at end of input.
    Read_Line Message Reading
    If Var Message == "Done"
    {
        Set_Var Reading 0
    }
    If Var Reading == 1
    {
        Network Send Echo Var Message
        Network Receive Echo
    }
}
Network Disconnect Echo
Return
