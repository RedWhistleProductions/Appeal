// Physics positions use +Y up and the same pixel scale as Mechanics.
Physics Set_Units_Per_Meter 64
Physics Set_Gravity 0 -1800 0
Set_Var Scene_Physics_Active 1
Mechanics Set Adam External_Physics 1
Physics Use Adam Default
Physics Set Adam Category 2
Physics Set Adam Mask 1
Physics Set Adam Friction 0
Physics Set_Capsule Adam 24 150
Mechanics Set Eve External_Physics 1
Physics Use Eve Default
Physics Set Eve Category 2
Physics Set Eve Mask 1
Physics Set Eve Friction 0
Physics Set_Capsule Eve 24 150
Define_Function Scene_Physics_Rebuild
    Physics Release Ground_0
    Set_Var Collision_Tile (World Get_Tile Var Scene_Left 0 0 Name)
    If Var Collision_Tile != ""
    {
        Physics Use Ground_0 Default
        Physics Set_Body_Type Ground_0 Static
        Physics Set_Box Ground_0 64 64
        Set_Var Collision_X (Subtract (World Get_Tile Var Scene_Left 0 0 X) Var Scene_Camera_X)
        Set_Var Collision_Y (Subtract 480 (World Get_Tile Var Scene_Left 0 0 Y))
        Physics Set_Position Ground_0 (Add Var Collision_X 32) Var Collision_Y 0
    }
