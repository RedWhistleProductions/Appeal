    Physics Release Ground_46
    Set_Var Collision_Tile (World Get_Tile Var Scene_Right 6 2 Name)
    If Var Collision_Tile != ""
    {
        Physics Use Ground_46 Default
        Physics Set_Body_Type Ground_46 Static
        Physics Set_Box Ground_46 64 64
        Set_Var Collision_X (Subtract (World Get_Tile Var Scene_Right 6 2 X) Var Scene_Camera_X)
        Set_Var Collision_Y (Subtract 480 (World Get_Tile Var Scene_Right 6 2 Y))
        Physics Set_Position Ground_46 (Add Var Collision_X 32) Var Collision_Y 0
    }
    Physics Release Ground_47
    Set_Var Collision_Tile (World Get_Tile Var Scene_Right 7 2 Name)
    If Var Collision_Tile != ""
    {
        Physics Use Ground_47 Default
        Physics Set_Body_Type Ground_47 Static
        Physics Set_Box Ground_47 64 64
        Set_Var Collision_X (Subtract (World Get_Tile Var Scene_Right 7 2 X) Var Scene_Camera_X)
        Set_Var Collision_Y (Subtract 480 (World Get_Tile Var Scene_Right 7 2 Y))
        Physics Set_Position Ground_47 (Add Var Collision_X 32) Var Collision_Y 0
    }
    Physics Release Scene_Door_Left
    Physics Use Scene_Door_Left Default
    Physics Set_Body_Type Scene_Door_Left Static
    Physics Set Scene_Door_Left Sensor 1
    Physics Set Scene_Door_Left Tag Door
    Physics Set_Box Scene_Door_Left 8 2048
    Physics Set_Position Scene_Door_Left 100 512 0
    Physics Release Scene_Door_Right
    Physics Use Scene_Door_Right Default
    Physics Set_Body_Type Scene_Door_Right Static
    Physics Set Scene_Door_Right Sensor 1
    Physics Set Scene_Door_Right Tag Door
    Physics Set_Box Scene_Door_Right 8 2048
    Physics Set_Position Scene_Door_Right 924 512 0
    Physics Release Scene_Crate
    Physics Use Scene_Crate Default
    Physics Set_Body_Type Scene_Crate Static
    Physics Set_Box Scene_Crate 64 64
    Physics Set_Position Scene_Crate 800 32 0
    Physics Set_Position Adam (Add (Mechanics Get Adam Position_X) 96) (Add (Mechanics Get Adam Position_Y) 75) 0
    Physics Set_Velocity Adam (Mechanics Get Adam Velocity_X) (Mechanics Get Adam Velocity_Y) 0
    Physics Set_Position Eve (Add (Mechanics Get Eve Position_X) 96) (Add (Mechanics Get Eve Position_Y) 75) 0
    Physics Set_Velocity Eve (Mechanics Get Eve Velocity_X) (Mechanics Get Eve Velocity_Y) 0
End_Function
Define_Function Scene_Physics_Update
    Call Adam_Apply_Mechanics
    Call Eve_Apply_Mechanics
    Physics Set_Velocity Adam (Mechanics Get Adam Velocity_X) (Mechanics Get Adam Velocity_Y) 0
    Physics Set_Velocity Eve (Mechanics Get Eve Velocity_X) (Mechanics Get Eve Velocity_Y) 0
    Physics Step 0.016666667
    Mechanics Set Adam Position_X (Subtract (Physics Get Adam Position_X) 96)
    Mechanics Set Adam Position_Y (Subtract (Physics Get Adam Position_Y) 75)
    Mechanics Set Adam Velocity_X (Physics Get Adam Velocity_X)
    Mechanics Set Adam Velocity_Y (Physics Get Adam Velocity_Y)
    Mechanics Set Adam Grounded (Physics Get Adam Grounded)
    Mechanics Update Adam
    Mechanics Set Eve Position_X (Subtract (Physics Get Eve Position_X) 96)
    Mechanics Set Eve Position_Y (Subtract (Physics Get Eve Position_Y) 75)
    Mechanics Set Eve Velocity_X (Physics Get Eve Velocity_X)
    Mechanics Set Eve Velocity_Y (Physics Get Eve Velocity_Y)
    Mechanics Set Eve Grounded (Physics Get Eve Grounded)
    Mechanics Update Eve
End_Function
Define_Function Scene_Physics_Check_Advance
    Set_Var Scene_Advance 0
    If (Physics Touching Adam Scene_Door_Left) == 1
    {
        Set_Var Scene_Advance -1
    }
    If (Physics Touching Eve Scene_Door_Left) == 1
    {
        Set_Var Scene_Advance -1
    }
    If (Physics Touching Adam Scene_Door_Right) == 1
    {
        Set_Var Scene_Advance 1
    }
    If (Physics Touching Eve Scene_Door_Right) == 1
    {
        Set_Var Scene_Advance 1
    }
    If Var Scene_Advance != 0
    {
        Call Scene_Switch_Page
    }
End_Function
Define_Function Scene_Physics_Close
    Physics Release Scene_Door_Left
    Physics Release Scene_Door_Right
    Physics Release Adam
    Physics Release Eve
    Physics Release Scene_Crate
    Physics Release Ground_0
    Physics Release Ground_1
    Physics Release Ground_2
    Physics Release Ground_3
    Physics Release Ground_4
    Physics Release Ground_5
    Physics Release Ground_6
    Physics Release Ground_7
    Physics Release Ground_8
    Physics Release Ground_9
    Physics Release Ground_10
    Physics Release Ground_11
    Physics Release Ground_12
    Physics Release Ground_13
    Physics Release Ground_14
    Physics Release Ground_15
    Physics Release Ground_16
    Physics Release Ground_17
    Physics Release Ground_18
    Physics Release Ground_19
    Physics Release Ground_20
    Physics Release Ground_21
    Physics Release Ground_22
    Physics Release Ground_23
    Physics Release Ground_24
    Physics Release Ground_25
    Physics Release Ground_26
    Physics Release Ground_27
    Physics Release Ground_28
    Physics Release Ground_29
    Physics Release Ground_30
    Physics Release Ground_31
    Physics Release Ground_32
    Physics Release Ground_33
    Physics Release Ground_34
    Physics Release Ground_35
    Physics Release Ground_36
    Physics Release Ground_37
    Physics Release Ground_38
    Physics Release Ground_39
    Physics Release Ground_40
    Physics Release Ground_41
    Physics Release Ground_42
    Physics Release Ground_43
    Physics Release Ground_44
    Physics Release Ground_45
    Physics Release Ground_46
    Physics Release Ground_47
    Set_Var Scene_Physics_Active 0
End_Function
Call Scene_Physics_Rebuild
Return
