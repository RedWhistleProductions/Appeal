// The same named texture works on ordinary Graphics mesh surfaces.
Run Setup/Config
Graphics Add_Window Main "Video on a surface" 960 640
Graphics Set_GUI_Visible False
Graphics Set_FPS 60
Video Load Screen Sample.mp4
Video Bind_Texture Screen Screen_Video
Graphics Load_Asset Screen_Surface Examples/Video_Screen.obj
Graphics Set_Texture Screen_Surface Screen_Video
Graphics Paste Screen_Surface 0 0 0
Video Play
Set_Var Video_Open 1
Loop While Var Video_Open == 1
{
    Video Update
    Graphics Render
    Graphics Update
    Graphics Window_Open Main
    Set_Var_Global Video_Open Graphics.Window.Main.Open
    If (Video Is_Playing) == 0 { Set_Var Video_Open 0 }
}
Video Close_All
Graphics Close_All
Done
