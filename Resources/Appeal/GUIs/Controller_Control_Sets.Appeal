// Internal persistence and binding helpers. Loaded by CONFIG_Controller.
Define_Function CONFIG_Controller_Apply
    Input Set_Controller_Button_Down B Var CONFIG_Value_A
    Input Set_Controller_Button_Up B Var CONFIG_Value_A_Up
    Input Set_Controller_Button_Repeat B 0
    Input Set_Controller_Button_Down A Var CONFIG_Value_B
    Input Set_Controller_Button_Up A Var CONFIG_Value_B_Up
    Input Set_Controller_Button_Repeat A 0
    Input Set_Controller_Button_Down Y Var CONFIG_Value_X
    Input Set_Controller_Button_Up Y Var CONFIG_Value_X_Up
    Input Set_Controller_Button_Repeat Y 0
    Input Set_Controller_Button_Down X Var CONFIG_Value_Y
    Input Set_Controller_Button_Up X Var CONFIG_Value_Y_Up
    Input Set_Controller_Button_Repeat X 0
    Input Set_Controller_Button_Down DPad_Up Var CONFIG_Value_DPad_Up
    Input Set_Controller_Button_Up DPad_Up Var CONFIG_Value_DPad_Up_Up
    Input Set_Controller_Button_Repeat DPad_Up 0
    Input Set_Controller_Button_Down DPad_Down Var CONFIG_Value_DPad_Down
    Input Set_Controller_Button_Up DPad_Down Var CONFIG_Value_DPad_Down_Up
    Input Set_Controller_Button_Repeat DPad_Down 0
    Input Set_Controller_Button_Down DPad_Left Var CONFIG_Value_DPad_Left
    Input Set_Controller_Button_Up DPad_Left Var CONFIG_Value_DPad_Left_Up
    Input Set_Controller_Button_Repeat DPad_Left 0
    Input Set_Controller_Button_Down DPad_Right Var CONFIG_Value_DPad_Right
    Input Set_Controller_Button_Up DPad_Right Var CONFIG_Value_DPad_Right_Up
    Input Set_Controller_Button_Repeat DPad_Right 0
    Input Set_Controller_Button_Down Left_Shoulder Var CONFIG_Value_L
    Input Set_Controller_Button_Up Left_Shoulder Var CONFIG_Value_L_Up
    Input Set_Controller_Button_Repeat Left_Shoulder 0
    Input Set_Controller_Button_Down Right_Shoulder Var CONFIG_Value_R
    Input Set_Controller_Button_Up Right_Shoulder Var CONFIG_Value_R_Up
    Input Set_Controller_Button_Repeat Right_Shoulder 0
    Input Set_Controller_Button_Down Left_Trigger Var CONFIG_Value_ZL
    Input Set_Controller_Button_Up Left_Trigger Var CONFIG_Value_ZL_Up
    Input Set_Controller_Button_Repeat Left_Trigger 0
    Input Set_Controller_Button_Down Right_Trigger Var CONFIG_Value_ZR
    Input Set_Controller_Button_Up Right_Trigger Var CONFIG_Value_ZR_Up
    Input Set_Controller_Button_Repeat Right_Trigger 0
    Input Set_Controller_Button_Down Left_Stick Var CONFIG_Value_Left_Stick
    Input Set_Controller_Button_Up Left_Stick Var CONFIG_Value_Left_Stick_Up
    Input Set_Controller_Button_Repeat Left_Stick 0
    Input Set_Controller_Button_Down Right_Stick Var CONFIG_Value_Right_Stick
    Input Set_Controller_Button_Up Right_Stick Var CONFIG_Value_Right_Stick_Up
    Input Set_Controller_Button_Repeat Right_Stick 0
    Input Set_Controller_Button_Down Back Var CONFIG_Value_Minus
    Input Set_Controller_Button_Up Back Var CONFIG_Value_Minus_Up
    Input Set_Controller_Button_Repeat Back 0
    Input Set_Controller_Button_Down Start Var CONFIG_Value_Plus
    Input Set_Controller_Button_Up Start Var CONFIG_Value_Plus_Up
    Input Set_Controller_Button_Repeat Start 0
    Input Set_Controller_Button_Down Guide Var CONFIG_Value_Home
    Input Set_Controller_Button_Up Guide Var CONFIG_Value_Home_Up
    Input Set_Controller_Button_Repeat Guide 0
    Input Set_Controller_Button_Down Touchpad Var CONFIG_Value_Touchpad
    Input Set_Controller_Button_Up Touchpad Var CONFIG_Value_Touchpad_Up
    Input Set_Controller_Button_Repeat Touchpad 0
    Input Set_Controller_Button_Down Paddle1 Var CONFIG_Value_Paddle1
    Input Set_Controller_Button_Up Paddle1 Var CONFIG_Value_Paddle1_Up
    Input Set_Controller_Button_Repeat Paddle1 0
    Input Set_Controller_Button_Down Paddle2 Var CONFIG_Value_Paddle2
    Input Set_Controller_Button_Up Paddle2 Var CONFIG_Value_Paddle2_Up
    Input Set_Controller_Button_Repeat Paddle2 0
    Input Set_Controller_Button_Down Paddle3 Var CONFIG_Value_Paddle3
    Input Set_Controller_Button_Up Paddle3 Var CONFIG_Value_Paddle3_Up
    Input Set_Controller_Button_Repeat Paddle3 0
    Input Set_Controller_Button_Down Paddle4 Var CONFIG_Value_Paddle4
    Input Set_Controller_Button_Up Paddle4 Var CONFIG_Value_Paddle4_Up
    Input Set_Controller_Button_Repeat Paddle4 0
End_Function
Define_Function CONFIG_Controller_Load_Existing
    Set_Var CONFIG_Controller_Name Var CONFIG_Controller_Wanted
    Set_Var CONFIG_Value_A (Storage Get_Field Control_Sets Name Var CONFIG_Controller_Name A)
    Graphics GUI_Set_Text_Value CONFIG_A Var CONFIG_Value_A
    Set_Var CONFIG_Value_A_Up (Storage Get_Field Control_Sets Name Var CONFIG_Controller_Name A_Up)
    Graphics GUI_Set_Text_Value CONFIG_A_Up Var CONFIG_Value_A_Up
    Set_Var CONFIG_Value_B (Storage Get_Field Control_Sets Name Var CONFIG_Controller_Name B)
    Graphics GUI_Set_Text_Value CONFIG_B Var CONFIG_Value_B
    Set_Var CONFIG_Value_B_Up (Storage Get_Field Control_Sets Name Var CONFIG_Controller_Name B_Up)
    Graphics GUI_Set_Text_Value CONFIG_B_Up Var CONFIG_Value_B_Up
