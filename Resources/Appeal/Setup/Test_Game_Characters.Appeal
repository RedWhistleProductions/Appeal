// Character templates and sprite sheets. Called inside Setup/Test_Game transaction.
// Paths are relative to Graphics/Sprites; existing catalog edits are preserved.
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Characters (Name TEXT PRIMARY KEY, Entity_Type TEXT NOT NULL DEFAULT 'Character', Immutable INTEGER NOT NULL DEFAULT 0 CHECK(Immutable = 0), Default_Sprite_Sheet TEXT NOT NULL);"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Character_Sprite_Sheets (Name TEXT PRIMARY KEY, Character_Name TEXT NOT NULL REFERENCES Characters(Name), File TEXT NOT NULL UNIQUE, Metadata_File TEXT NOT NULL DEFAULT '', Frame_Width INTEGER NOT NULL CHECK(Frame_Width > 0), Frame_Height INTEGER NOT NULL CHECK(Frame_Height > 0), Columns INTEGER NOT NULL CHECK(Columns > 0), Rows INTEGER NOT NULL CHECK(Rows > 0), Projection TEXT NOT NULL);"
Storage Execute_SQL "INSERT OR IGNORE INTO Characters (Name, Default_Sprite_Sheet) VALUES ('Adam', 'Adam_Movement');"
