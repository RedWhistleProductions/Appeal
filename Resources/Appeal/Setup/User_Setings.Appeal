// Call after Run Setup/Config. Independent of any game's database setup.
// Shared across games. Spelling User_Setings is intentional.
Storage Use User_Setings
Storage Begin
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Schema_Info (Name TEXT PRIMARY KEY, Version INTEGER NOT NULL);"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS User_Settings (Key TEXT PRIMARY KEY, Value TEXT NOT NULL);"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Controllers (ID TEXT PRIMARY KEY, Name TEXT NOT NULL, Deadzone INTEGER NOT NULL DEFAULT 24 CHECK(Deadzone BETWEEN 0 AND 99));"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Input_Bindings (Profile TEXT NOT NULL, Action TEXT NOT NULL, Device TEXT NOT NULL, Control TEXT NOT NULL, Scale INTEGER NOT NULL DEFAULT 100 CHECK(Scale BETWEEN -100 AND 100), PRIMARY KEY(Profile, Action, Device, Control));"
Storage Execute_SQL "INSERT OR IGNORE INTO Schema_Info VALUES ('User_Setings', 1);"
Storage Execute_SQL "INSERT OR IGNORE INTO User_Settings VALUES ('Input.Focus_Toggle', 'F1');"
Storage Execute_SQL "INSERT OR IGNORE INTO Controllers VALUES ('Default', 'Default controller', 24);"
Storage Execute_SQL "INSERT OR IGNORE INTO Input_Bindings VALUES ('Player1', 'Move', 'Keyboard', 'A', -100), ('Player1', 'Move', 'Keyboard', 'D', 100), ('Player1', 'Run', 'Keyboard', 'Left Shift', 100), ('Player1', 'Duck', 'Keyboard', 'Left Ctrl', 100), ('Player1', 'Jump', 'Keyboard', 'Space', 100);"
Storage Execute_SQL "INSERT OR IGNORE INTO Input_Bindings VALUES ('Player2', 'Move', 'Keyboard', 'Left', -100), ('Player2', 'Move', 'Keyboard', 'Right', 100), ('Player2', 'Run', 'Keyboard', 'Right Shift', 100), ('Player2', 'Duck', 'Keyboard', 'Right Ctrl', 100), ('Player2', 'Jump', 'Keyboard', 'Return', 100);"
Storage Execute_SQL "INSERT OR IGNORE INTO Input_Bindings VALUES ('Player1', 'Move', 'ControllerAxis', 'Left_Stick_X', 100), ('Player1', 'Jump', 'ControllerButton', 'A', 100), ('Player1', 'Duck', 'ControllerButton', 'B', 100), ('Player1', 'Run', 'ControllerButton', 'X', 100);"
Storage Execute_SQL "CREATE TABLE IF NOT EXISTS Control_Sets (Name TEXT PRIMARY KEY, A TEXT NOT NULL DEFAULT '', A_Up TEXT NOT NULL DEFAULT '', B TEXT NOT NULL DEFAULT '', B_Up TEXT NOT NULL DEFAULT '', X TEXT NOT NULL DEFAULT '', X_Up TEXT NOT NULL DEFAULT '', Y TEXT NOT NULL DEFAULT '', Y_Up TEXT NOT NULL DEFAULT '', DPad_Up TEXT NOT NULL DEFAULT '', DPad_Up_Up TEXT NOT NULL DEFAULT '', DPad_Down TEXT NOT NULL DEFAULT '', DPad_Down_Up TEXT NOT NULL DEFAULT '', DPad_Left TEXT NOT NULL DEFAULT '', DPad_Left_Up TEXT NOT NULL DEFAULT '', DPad_Right TEXT NOT NULL DEFAULT '', DPad_Right_Up TEXT NOT NULL DEFAULT '', L TEXT NOT NULL DEFAULT '', L_Up TEXT NOT NULL DEFAULT '', R TEXT NOT NULL DEFAULT '', R_Up TEXT NOT NULL DEFAULT '', ZL TEXT NOT NULL DEFAULT '', ZL_Up TEXT NOT NULL DEFAULT '', ZR TEXT NOT NULL DEFAULT '', ZR_Up TEXT NOT NULL DEFAULT '', Left_Stick TEXT NOT NULL DEFAULT '', Left_Stick_Up TEXT NOT NULL DEFAULT '', Right_Stick TEXT NOT NULL DEFAULT '', Right_Stick_Up TEXT NOT NULL DEFAULT '', Minus TEXT NOT NULL DEFAULT '', Minus_Up TEXT NOT NULL DEFAULT '', Plus TEXT NOT NULL DEFAULT '', Plus_Up TEXT NOT NULL DEFAULT '', Home TEXT NOT NULL DEFAULT '', Home_Up TEXT NOT NULL DEFAULT '', Touchpad TEXT NOT NULL DEFAULT '', Touchpad_Up TEXT NOT NULL DEFAULT '', Paddle1 TEXT NOT NULL DEFAULT '', Paddle1_Up TEXT NOT NULL DEFAULT '', Paddle2 TEXT NOT NULL DEFAULT '', Paddle2_Up TEXT NOT NULL DEFAULT '', Paddle3 TEXT NOT NULL DEFAULT '', Paddle3_Up TEXT NOT NULL DEFAULT '', Paddle4 TEXT NOT NULL DEFAULT '', Paddle4_Up TEXT NOT NULL DEFAULT '');"
Storage Execute_SQL "INSERT OR IGNORE INTO Control_Sets (Name, A, A_Up, B, B_Up, X, X_Up, Y, Y_Up, DPad_Up, DPad_Up_Up, DPad_Down, DPad_Down_Up, DPad_Left, DPad_Left_Up, DPad_Right, DPad_Right_Up, L, L_Up, R, R_Up, ZL, ZL_Up, ZR, ZR_Up, Left_Stick, Left_Stick_Up, Right_Stick, Right_Stick_Up, Minus, Minus_Up, Plus, Plus_Up, Home, Home_Up, Touchpad, Touchpad_Up, Paddle1, Paddle1_Up, Paddle2, Paddle2_Up, Paddle3, Paddle3_Up, Paddle4, Paddle4_Up) VALUES ('Test_Game', 'Adam_Pad_Duck_Down', 'Adam_Pad_Duck_Up', 'Adam_Jump', '', '', '', 'Adam_Pad_Run_Down', 'Adam_Pad_Run_Up', '', '', '', '', 'Adam_Pad_Left_Down', 'Adam_Pad_Left_Up', 'Adam_Pad_Right_Down', 'Adam_Pad_Right_Up', '', '', '', '', '', '', '', '', '', '', '', '', 'Input.Toggle_Focus', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '');"
Storage Execute_SQL "INSERT OR IGNORE INTO User_Settings VALUES ('Controller.Active_Control_Set', 'Test_Game');"
Storage Execute_SQL "UPDATE Schema_Info SET Version = 2 WHERE Name = 'User_Setings' AND Version < 2;"
Storage Commit
Return
