Define_Function Arcade_Draw_Board
    Set_Var A_BX 0
    Set_Var A_BY 0
    Set_Var A_Walkable 1
    If Var A_Index == 18 { Set_Var A_Walkable Var A_Cell0 }
    Set_Var A_Cell_ID 0
    Call Arcade_Draw_Cell
