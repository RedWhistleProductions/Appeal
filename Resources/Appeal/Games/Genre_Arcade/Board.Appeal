Define_Function Arcade_Draw_Cell
    Set_Var A_Art "Examples/Terrain/Terrain_Tiles_Top_Down.png"
    Set_Var A_Frame 0
    If Var A_Walkable == 0 { Set_Var A_Frame 12 }
    If Var A_BX == 0 { Set_Var A_Frame 12 }
    If Var A_BX == 6 { Set_Var A_Frame 12 }
    If Var A_BY == 0 { Set_Var A_Frame 12 }
    If Var A_BY == 4 { Set_Var A_Frame 12 }
    If Var A_Index == 8
    {
        If Var A_BX == 3 { Set_Var A_Frame 8 }
        If Var A_BX == 5 { Set_Var A_Frame 8 }
    }
    If Var A_BX == Var A_EX
    {
        If Var A_BY == Var A_EY
        {
            If Var A_Enemy > 0
            {
                Set_Var A_Art "Examples/Characters/Slime/Slime.png"
                Set_Var A_Frame 0
            }
            If Var A_Index == 18
            {
                Set_Var A_Art "Examples/Terrain/Terrain_Tiles_Top_Down.png"
                Set_Var A_Frame 4
            }
        }
    }
    If Var A_BX == Var A_X
    {
        If Var A_BY == Var A_Y
        {
            Set_Var A_Art "Examples/Characters/Villager_Female/Villager_Female_Top_Down.png"
            Set_Var A_Frame 0
        }
    }
    Graphics GUI_Image Var A_Cell_ID Var A_Art 64 64 Var A_Frame 1 56
    If Var A_BX < 6 { Graphics GUI_Same_Line }
    Set_Var A_BX (Add Var A_BX 1)
    If Var A_BX > 6
    {
        Set_Var A_BX 0
        Set_Var A_BY (Add Var A_BY 1)
    }
End_Function
