Add_Dynamic_Module Graphics Appeal_SDL2_Legacy_OpenGL_Graphics
Add_Dynamic_Module Input Appeal_SDL2_Input
Add_Dynamic_Module Storage Appeal_SQLite_Storage
Add_Dynamic_Module Audio Appeal_SDL2_Audio
Run Games/Genre_Arcade/Core
Run Games/Genre_Arcade/Interface
Call Arcade_Init
Audio Load_SFX Arcade_Win "Quiz/Correct.wav"
Audio Load_SFX Arcade_Lose "Quiz/Wrong.wav"
Set_Var A_Audio 1
Graphics Add_Window Main "Bananas Genre Arcade" 1100 800
Graphics Set_FPS 60
Graphics Set_GUI_Docking False
Graphics Set_GUI_Visible True
Graphics GUI_Set_Window_Functions Genre_Arcade Arcade_Quit ""
Input Set_Focus GUI
Input Open_Controller -1
Set_Var A_Open 1
Loop While Var A_Open == 1
{
    Input Update Default
    Call Game_Update
    Call Game_Dispatch_Events
    Call Arcade_Tick
    Call Arcade_Draw
    Graphics Render
    Graphics Update
    Graphics Window_Open Main
    Set_Var_Global A_Open Graphics.Window.Main.Open
    If Var A_Quit == 1 { Set_Var A_Open 0 }
}
Input Close_Controller -1
Graphics Close_All
Storage Close Genre_Arcade
Done
