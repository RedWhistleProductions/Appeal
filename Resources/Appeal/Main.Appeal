Run Setup/Config
Run Bananas/Splash

//Run Game_Setup


//Set_Var Game_State Bananas/Start
Set_Var Game_State Bananas/Editor
//Set_Var Game_State Bananas/Game_Browser
Set_Var Active_Game ""
Set_Var Music_Playlist_File_Path ""

Define_Function Select_Game
Graphics GUI_File_Picker_Value Game_File_Picker
Set_Var_Global Game_Selected_Path Graphics.GUI.Game_File_Picker.Selected_Path
Set_Var_Global Game_Selected_Is_Directory Graphics.GUI.Game_File_Picker.Selected_Is_Directory
Set_Var_Global Game_Selected_Relative Graphics.GUI.Game_File_Picker.Selected_Relative
If Var Game_Selected_Is_Directory == True
{
	Set_Var Active_Game Var Game_Selected_Relative
	Graphics GUI_Set_Text_Value Level_Game_Name Var Active_Game
	Files Join Appeal/Games Var Active_Game
	Set_Var_Global Game_Folder_Path Files.Last_Path
	Files Join Var Game_Folder_Path Levels
	Set_Var_Global Game_Levels_Folder_Path Files.Last_Path
	Graphics GUI_File_Picker_Set_Start Level_File_Picker Var Game_Levels_Folder_Path
}
End_Function

Loop While Var Main_Open == True
{
	Graphics Update
	Input Update Default
	//Audio Update
	Graphics Window_Open Main
	Set_Var_Global Main_Open Graphics.Window.Main.Open

	Run Var Game_State

	Graphics Render
}

Done
